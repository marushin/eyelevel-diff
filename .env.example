SERPAPI_API_KEY=your_serpapi_api_key
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-opus-5-5
# Only required when LLM_PROVIDER=openai.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-6.1-sol
PORT=3000
# Deconstruct service, started together with `pnpm dev` and `pnpm start`.
# DECONSTRUCT_ENABLED=false
# DECONSTRUCT_PORT=3001
# Free layout work: no Claude calls, same response shape.
# SEGMENT_MODE=rule
# VISION_MAX_PER_PAGE=0
