# 의미 분할에 쓰는 Claude API 키. 비워 두면 규칙 분할만 사용합니다.
ANTHROPIC_API_KEY=

# auto: 키가 있으면 LLM, 없으면 규칙 / rule: 항상 규칙
SEGMENT_MODE=auto
SEGMENT_MODEL=claude-opus-5-5
SEGMENT_EFFORT=low

# 이번 해커톤의 Claude API 지출 한도(달러). 누적액은 data/usage.json에 남습니다.
LLM_BUDGET_USD=100

# 페이지당 Vision으로 설명할 이미지 수. 0이면 끕니다.
VISION_MAX_PER_PAGE=12

# 조각을 검색어 구절로 다시 나눌 때 쓰는 모델. SEGMENT_MODE=rule이면 호출하지 않습니다.
REFINE_MODEL=claude-haiku-5-5

# 공개 배포 시 프론트엔드 주소로 지정. 쉼표로 여러 개 가능
CORS_ORIGIN=*
LOG_LEVEL=info
