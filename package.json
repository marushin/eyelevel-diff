{
  "name": "art-hackathon-local",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "local": "node scripts/local.mjs",
    "local:preview": "node scripts/local.mjs --preview",
    "dev": "pnpm --filter @akl/card-stack dev",
    "build": "pnpm --filter @akl/card-stack build",
    "check": "tsc -p packages/graph-contract && tsc -p packages/lab-kit && tsc -p apps/web",
    "test": "vitest run",
    "test:e2e": "node tests/e2e-local.mjs --profile"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright-core": "1.65.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.25.0"
}
