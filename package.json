{
  "name": "art-hackathon-merge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "pnpm --filter @akl/card-stack build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "check": "tsc -p packages/graph-contract && tsc -p packages/lab-kit && tsc -p apps/web",
    "test": "pnpm test:api && pnpm test:web",
    "test:api": "node --test apps/api/*.test.js tests/*.test.mjs",
    "test:web": "vitest run",
    "test:deconstruct": "pnpm --filter @akl/deconstruct-api test",
    "setup:deconstruct": "pnpm --filter @akl/deconstruct-api browser:install"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.25.0"
}
